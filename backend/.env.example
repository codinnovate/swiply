# ── Required to boot ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/swiply
# Minimum 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# ── Google sign-in (optional; omit and /api/auth/google returns 422) ──────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ── Social connections, Sections 6 & 12 (build step 2) ───────────────────────
# Public origin of this API. Platform OAuth redirect URIs are built from it and
# must match what is registered in each provider's developer console.
API_BASE_URL=http://localhost:3000

# AES-256-GCM key for SocialAccount tokens at rest. 64 hex chars (32 bytes).
# Required as of build step 2. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── AI (build steps 3, 5, 8, 10) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
IMAGE_GEN_API_KEY=
VIDEO_GEN_API_KEY=            # Remotion/Shotstack or text-to-video provider
TTS_API_KEY=                  # ElevenLabs/OpenAI TTS, if using templated video assembly

# ── Storage (build step 4) ───────────────────────────────────────────────────
CLOUDINARY_URL=               # or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / S3_BUCKET

# ── Billing (build step 12) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Queues + rate limiting (build step 6) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Platform adapters (build steps 2, 9) ─────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=    # for Instagram/Facebook comment webhooks
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_API_TIER=free         # 'free' | 'basic' | 'pro' — gates whether mention polling is attempted
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Email (build step 11) ────────────────────────────────────────────────────
RESEND_API_KEY=
