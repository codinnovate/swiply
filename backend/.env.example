# ── Required to boot ──────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/swiply
# Minimum 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

NODE_ENV=development
PORT=3000

# POSTLOCK public X profile verification. "fxtwitter" needs no API key.
# Use "http" with the URL/key below for another compliant provider.
X_DATA_PROVIDER=fxtwitter
X_DATA_PROVIDER_API_KEY=
X_DATA_PROVIDER_BASE_URL=
POSTING_PROVIDER_TIMEOUT_MS=8000
FRONTEND_URL=http://localhost:3001

# ── Google sign-in (optional; omit and /api/auth/google returns 422) ──────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ── Social connections, Sections 6 & 12 (build step 2) ───────────────────────
# Public origin of this API. Platform OAuth redirect URIs are built from it and
# must match what is registered in each provider's developer console.
API_BASE_URL=http://localhost:3000

# AES-256-GCM key for SocialAccount tokens at rest. 64 hex chars (32 bytes).
# Required as of build step 2. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── AI ───────────────────────────────────────────────────────────────────────
# No deployment AI key. Users add personal OpenAI, Anthropic, or Gemini keys in the app.

# ── Storage (build step 4) ───────────────────────────────────────────────────
AWS_REGION=us-east-1
S3_BUCKET=
CLOUDFRONT_DOMAIN=            # e.g. d123example.cloudfront.net (no path required)
CLOUDFRONT_DISTRIBUTION_ID=
# Optional for S3-compatible local emulators. Credentials use the standard AWS
# chain: deployment IAM role, AWS_PROFILE, or these long-lived keys (local/Railway).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=

# ── Billing (build step 12) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Queues + rate limiting (build step 6) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Platform adapters (build steps 2, 9) ─────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=    # for Instagram/Facebook comment webhooks
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_API_TIER=free         # 'free' | 'basic' | 'pro' — gates whether mention polling is attempted
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Email (build step 11) ────────────────────────────────────────────────────
RESEND_API_KEY=

# ── TikTok competitor research ───────────────────────────────────────────────
# Official TikTok APIs cannot search other accounts. TikAPI is a public-data
# REST API used to look up competitor videos by keyword and hashtag.
# Create a key at https://tikapi.io/ (5-day trial, then paid).
TIKAPI_KEY=
# Set to true only when testing against TikAPI's sandbox.
TIKAPI_SANDBOX=false
